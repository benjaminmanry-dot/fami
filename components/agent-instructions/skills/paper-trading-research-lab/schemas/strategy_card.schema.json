{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper-Trading Strategy Card",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_id",
    "edge_family",
    "hypothesis",
    "edge_rationale",
    "persistence_reason",
    "decay_or_crowding_risk",
    "market_universe_fit",
    "data_required",
    "data_risks",
    "execution_feasibility",
    "expected_capacity",
    "holding_period",
    "turnover_expectation",
    "benchmark",
    "baseline_strategies",
    "entry_signal",
    "exit_signal",
    "universe_filter",
    "position_sizing_rule",
    "rebalancing_rule",
    "expected_failure_modes",
    "parameter_search_bounds",
    "discovery_budget",
    "stopping_rule",
    "trial_family",
    "negative_controls",
    "simulation_integrity_tests",
    "validation_plan",
    "promotion_gates",
    "prior_scores"
  ],
  "properties": {
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "edge_family": {
      "type": "string",
      "enum": [
        "trend or momentum",
        "value or relative value",
        "carry or term structure",
        "quality, profitability, or investment",
        "liquidity provision or short-horizon mean reversion",
        "volatility or option risk premium",
        "flow, hedging pressure, or positioning",
        "seasonality, calendar, or event effects",
        "market microstructure",
        "cross-asset linkage",
        "other"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "edge_rationale": {
      "type": "string",
      "minLength": 20
    },
    "persistence_reason": {
      "type": "string",
      "minLength": 10
    },
    "decay_or_crowding_risk": {
      "type": "string",
      "minLength": 10
    },
    "market_universe_fit": {
      "type": "string",
      "minLength": 10
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "data_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_feasibility": {
      "type": "string",
      "minLength": 10
    },
    "expected_capacity": {
      "type": "string",
      "minLength": 1
    },
    "holding_period": {
      "type": "string",
      "minLength": 1
    },
    "turnover_expectation": {
      "type": "string",
      "minLength": 1
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "baseline_strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entry_signal": {
      "type": "string",
      "minLength": 1
    },
    "exit_signal": {
      "type": "string",
      "minLength": 1
    },
    "universe_filter": {
      "type": "string",
      "minLength": 1
    },
    "position_sizing_rule": {
      "type": "string",
      "minLength": 1
    },
    "rebalancing_rule": {
      "type": "string",
      "minLength": 1
    },
    "expected_failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameter_search_bounds": {
      "type": "object"
    },
    "discovery_budget": {
      "type": "object",
      "required": [
        "max_variants",
        "max_data_versions",
        "max_universes"
      ],
      "properties": {
        "max_variants": {
          "type": "integer",
          "minimum": 0
        },
        "max_data_versions": {
          "type": "integer",
          "minimum": 1
        },
        "max_universes": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "stopping_rule": {
      "type": "string",
      "minLength": 1
    },
    "trial_family": {
      "type": "string",
      "minLength": 1
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "simulation_integrity_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "no-edge synthetic data",
        "shuffled-label placebo",
        "look-ahead trap",
        "corporate-action fixture",
        "order-timing fixture"
      ]
    },
    "validation_plan": {
      "type": "object",
      "required": [
        "train_period",
        "validation_period",
        "test_period",
        "primary_metric",
        "multiple_testing_adjustment",
        "cost_sensitivity"
      ],
      "additionalProperties": true
    },
    "promotion_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_rate_prior_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 27
    },
    "base_rate_prior_verdict": {
      "type": "string"
    },
    "prior_scores": {
      "type": "object",
      "required": [
        "rationale_strength",
        "evidence_quality",
        "market_fit",
        "data_feasibility",
        "execution_feasibility",
        "robustness_expectation",
        "decay_and_crowding_risk",
        "portfolio_distinctness",
        "simplicity"
      ],
      "properties": {
        "rationale_strength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "evidence_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "market_fit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "data_feasibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "execution_feasibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "robustness_expectation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "decay_and_crowding_risk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "portfolio_distinctness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "simplicity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    }
  }
}
