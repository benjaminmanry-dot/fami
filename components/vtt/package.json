{
  "name": "20fates-vtt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run typecheck && node --experimental-strip-types --test tests/character-creator.test.ts tests/character-handoff.test.ts tests/player-access-security.test.ts tests/release-package.test.ts tests/room-state.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "character:handoff": "node --experimental-strip-types scripts/prepare-character-handoff.ts",
    "character:catalogue": "node scripts/build-character-catalogue.mjs --source .local/creator-source/data --out data/character-catalogue.json --archive-sha256 C2A9D6C21C02FA278E59D6809FF54B2210F3C5EC939493DEC192480FDB3835C9",
    "corpus:build": "node scripts/build-assistant-corpus.mjs",
    "corpus:seed:local": "wrangler d1 execute site-creator-d1 --local --yes --config wrangler.local.jsonc --file corpus/assistant-corpus.sql"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
